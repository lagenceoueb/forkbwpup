{
	"name": "lagenceoueb/oueb-wp-backup",
	"description": "Sauvegarde et restauration de WordPress vers des hébergeurs européens. Fork de BackWPup 4.1.7.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "L'agence Oueb",
			"homepage": "https://lagenceoueb.tech"
		}
	],
	"require": {
		"php": ">=8.1",
		"christian-riesen/base32": "1.3.2",
		"guzzlehttp/psr7": "1.9.1",
		"inpsyde/backwpup-restore-shared": "0.20.3",
		"monolog/monolog": "2.9.3",
		"phpseclib/phpseclib": "3.0.39",
		"pimple/pimple": "v3.5.0",
		"psr/http-client": "1.0.3",
		"psr/http-factory": "1.1.0",
		"psr/http-message": "1.1",
		"symfony/options-resolver": "v4.4.44",
		"webmozart/assert": "1.11.0"
	},
	"autoload": {
		"classmap": [
			"backwpup.php",
			"inc/"
		],
		"psr-4": {
			"Inpsyde\\BackWPup\\": "src/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.1"
		}
	}
}
