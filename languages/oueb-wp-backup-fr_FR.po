#: inc/class-oueb-sftp-client.php:290
#, php-format
msgid "The SFTP connection failed: %s"
msgstr "La connexion SFTP a échoué : %s"

#: inc/class-oueb-webdav-client.php:356
msgid "The server refused the username or password. With kDrive, use an application password."
msgstr "Le serveur a refusé l'identifiant ou le mot de passe. Avec kDrive, utilisez un mot de passe d'application."

#: inc/class-oueb-webdav-client.php:357
msgid "The server refused access to this folder."
msgstr "Le serveur a refusé l'accès à ce dossier."

#: inc/class-oueb-webdav-client.php:358
msgid "The folder does not exist on the server."
msgstr "Ce dossier n'existe pas sur le serveur."

#: inc/class-oueb-webdav-client.php:359
