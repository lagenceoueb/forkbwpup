#: inc/class-page-settings.php:414
#, php-format
msgid "The key to start jobs externally was not changed: it needs at least %d letters and digits."
msgstr "La clé de démarrage externe n'a pas changé : il lui faut au moins %d lettres et chiffres."

#. translators: %d: minimum number of characters.
#: inc/class-page-settings.php:657
#, php-format
msgid "This key is too short to resist guessing. Replace it with at least %d letters and digits, then update the trigger links you use outside cron-job.org."
msgstr "Cette clé est trop courte pour résister à une recherche par essais. Remplacez-la par au moins %d lettres et chiffres, puis mettez à jour les liens de déclenchement que vous utilisez hors de cron-job.org."

#: inc/class-oueb-s3-client.php:288 inc/class-oueb-s3-client.php:620 inc/class-oueb-webdav-client.php:116
