msgstr "Impossible d'ouvrir le fichier à envoyer."

#: inc/class-destination-s3.php:55
msgid "Choose a service"
msgstr "Choisir un service"

#: inc/class-destination-s3.php:67
msgid "The service saved in this job is no longer offered. Backups to it stopped. Choose a European provider, then check the bucket."
msgstr "Le service enregistré dans cette opération n'est plus proposé et les sauvegardes vers lui sont arrêtées. Choisissez un fournisseur européen, puis vérifiez le bucket."

#: inc/class-backwpup-destination-sftp.php:59
msgid "SFTP server"
msgstr "Serveur SFTP"

#: inc/class-backwpup-destination-sftp.php:62
msgid "Server"
msgstr "Serveur"

#: inc/class-backwpup-destination-sftp.php:65
msgid "Domain name or IP address, without sftp://."
msgstr "Nom de domaine ou adresse IP, sans sftp://."

#: inc/class-backwpup-destination-sftp.php:69
msgid "Port"
msgstr "Port"

#: inc/class-backwpup-destination-sftp.php:73
msgid "Username"
msgstr "Identifiant"

#: inc/class-backwpup-destination-sftp.php:77 inc/class-backwpup-destination-sftp.php:80
msgid "Authentication"
msgstr "Authentification"

#: inc/class-backwpup-destination-sftp.php:81 inc/class-backwpup-destination-sftp.php:87
msgid "Password"
msgstr "Mot de passe"

#: inc/class-backwpup-destination-sftp.php:82
msgid "Private key (recommended)"
msgstr "Clé privée (recommandé)"

#: inc/class-backwpup-destination-sftp.php:94
msgid "Private key"
msgstr "Clé privée"

#: inc/class-backwpup-destination-sftp.php:97
msgid "Paste the whole key, including the BEGIN and END lines."
msgstr "Collez la clé entière, lignes BEGIN et END comprises."

#: inc/class-backwpup-destination-sftp.php:101
msgid "Key passphrase"
msgstr "Phrase de passe de la clé"

#: inc/class-backwpup-destination-sftp.php:104
msgid "Only if the key is protected by a passphrase."
msgstr "Seulement si une phrase de passe protège la clé."

#: inc/class-backwpup-destination-sftp.php:108
msgid "Server fingerprint"
msgstr "Empreinte du serveur"

#: inc/class-backwpup-destination-sftp.php:111
msgid "Saved at the first successful connection. The plugin then refuses any server whose key differs."
msgstr "Enregistrée à la première connexion réussie. L'extension refuse ensuite tout serveur dont la clé est différente."

#: inc/class-backwpup-destination-sftp.php:114
msgid "Forget this fingerprint (only after a server reinstallation)"
msgstr "Oublier cette empreinte (seulement après une réinstallation du serveur)"

#: inc/class-backwpup-destination-sftp.php:123
msgid "Folder on the server"
msgstr "Dossier sur le serveur"

#: inc/class-backwpup-destination-sftp.php:126
msgid "Relative to the home folder of the user, or absolute if it starts with /. Created if missing."
msgstr "Relatif au dossier personnel de l'utilisateur, ou absolu s'il commence par /. Créé s'il n'existe pas."

