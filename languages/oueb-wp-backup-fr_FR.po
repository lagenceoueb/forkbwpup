#. Plugin Name of the plugin
#: oueb-wp-backup.php
msgid "Oueb WP Backup"
msgstr "Oueb WP Backup"

#. Description of the plugin
#: oueb-wp-backup.php
msgid "Back up and restore WordPress to European hosting providers. Fork of BackWPup 4.1.7."
msgstr "Sauvegarde et restauration de WordPress vers des hébergeurs européens. Fork de BackWPup 4.1.7."

#. Author of the plugin
#: oueb-wp-backup.php
msgid "L'agence Oueb"
msgstr "L’agence Oueb"

