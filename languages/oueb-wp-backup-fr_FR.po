msgid "Stop requested: the run stops at the end of its current step."
msgstr "Arrêt demandé : l’exécution s’arrête à la fin de son étape en cours."

#: includes/cli/class-command.php:348
msgid "Give the ID of a backup, a --file, or a --storage with an --archive."
msgstr "Indiquez l’identifiant d’une sauvegarde, un --file, ou un --storage avec un --archive."

#: includes/cli/class-command.php:354
msgid "the database"
msgstr "la base de données"

#: includes/cli/class-command.php:357
msgid "the files"
msgstr "les fichiers"

#. translators: %s: "the database and the files", or one of them.
#: includes/cli/class-command.php:362
#, php-format
msgid "Replace %s of this site? The changes made since the backup will be lost."
msgstr "Remplacer %s de ce site ? Les modifications faites depuis la sauvegarde seront perdues."

#: includes/cli/class-command.php:363
msgid " and "
msgstr " et "

