#: includes/cli/class-command.php:444
#, php-format
msgid "%d job imported from BackWPup."
msgid_plural "%d jobs imported from BackWPup."
msgstr[0] "%d tâche importée de BackWPup."
msgstr[1] "%d tâches importées de BackWPup."

#: includes/cli/class-command.php:449
msgid "BackWPup is still active: both extensions would make the same backups. Deactivate it with `wp plugin deactivate backwpup`."
msgstr "BackWPup est encore actif : les deux extensions feraient les mêmes sauvegardes. Désactivez-le avec `wp plugin deactivate backwpup`."

#. translators: %d: number of tables.
#: includes/cli/class-command.php:512
#, php-format
msgid "%d table has an error."
msgid_plural "%d tables have an error."
msgstr[0] "%d table a une erreur."
msgstr[1] "%d tables ont une erreur."

