#: inc/class-backwpup-destination-sftp.php:478
#, php-format
msgid "%d file deleted on the SFTP server."
msgid_plural "%d files deleted on the SFTP server."
msgstr[0] "%d fichier supprimé sur le serveur SFTP."
msgstr[1] "%d fichiers supprimés sur le serveur SFTP."

#: inc/class-oueb-sftp-client.php:77
msgid "Enter the SFTP server and the username."
msgstr "Indiquez le serveur SFTP et l'identifiant."

#: inc/class-oueb-sftp-client.php:88
msgid "The SFTP server does not answer."
msgstr "Le serveur SFTP ne répond pas. Vérifiez son adresse et son port."

#. translators: 1: expected fingerprint, 2: received fingerprint.
#: inc/class-oueb-sftp-client.php:98
#, php-format
msgid "The SFTP server key has changed. Expected %1$s, received %2$s. If the server was reinstalled, clear the saved fingerprint in the job settings."
msgstr "La clé du serveur SFTP a changé : %1$s attendue, %2$s reçue. Si le serveur a été réinstallé, effacez l'empreinte enregistrée dans les réglages de l'opération."

#: inc/class-oueb-sftp-client.php:117
msgid "The SFTP server refused the username, password or key."
msgstr "Le serveur SFTP a refusé l'identifiant, le mot de passe ou la clé."

#. translators: %s: folder path on the server.
#: inc/class-oueb-sftp-client.php:163
#, php-format
msgid "Cannot create the folder %s on the SFTP server."
msgstr "Impossible de créer le dossier %s sur le serveur SFTP."

#. translators: %s: file path on the server.
#: inc/class-oueb-sftp-client.php:184
#, php-format
msgid "The upload of %s to the SFTP server failed."
msgstr "L'envoi de %s vers le serveur SFTP a échoué."

#. translators: %s: file path on the server.
#: inc/class-oueb-sftp-client.php:205
#, php-format
msgid "Cannot read %s on the SFTP server."
msgstr "Impossible de lire %s sur le serveur SFTP."

