msgstr[0] "Restauration terminée avec %d avertissement."
msgstr[1] "Restauration terminée avec %d avertissements."

#: includes/engine/class-runner.php:460
msgid "Backup finished."
msgstr "Sauvegarde terminée."

#. translators: %d: number of warnings.
#: includes/engine/class-runner.php:462
